<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>ArchipelagoAdvancedClient</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ApplicationIcon>wwwroot/favicon.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.1" />
        <PackageReference Include="Photino.Blazor" Version="4.0.13" />
        <!-- Photino.Blazor only ships net8.0/net9.0 assets, so without this NuGet resolves
             Microsoft.AspNetCore.Components.WebView to its net9.0 build (9.0.1) even though
             every other Components package here is 10.0.0 - pin it explicitly to match. -->
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ArchipelagoAdvancedClient.Shared\ArchipelagoAdvancedClient.Shared.csproj" />
    </ItemGroup>

</Project>
