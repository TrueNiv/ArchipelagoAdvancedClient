@namespace ArchipelagoAdvancedClient.Shared.Pages
@page "/chat"
@using Archipelago.MultiClient.Net
@using ArchipelagoAdvancedClient.Business.APConnector
@using ArchipelagoAdvancedClient.Shared.Components
@using ArchipelagoAdvancedClient.Shared.Models
@using ArchipelagoAdvancedClient.Shared.Services
@using Microsoft.AspNetCore.Components
@inject IArchipelagoConnectorService Connector
@inject ILocalStorageService LocalStorage

<PageTitle>Chat</PageTitle>

<div class="row g-2 align-items-end mb-2">
    <div class="col">
        <MudTextField T="string" Value="@url" ValueChanged="@(async (string v) => { url = v; await SaveSettingsAsync(); })" Immediate="true" Label="URL" Variant="Variant.Outlined" id="chat-url-input"/>
    </div>
    <div class="col">
        <MudTextField T="string" Value="@username" ValueChanged="@(async (string v) => { username = v; await SaveSettingsAsync(); })" Immediate="true" Label="Username" Variant="Variant.Outlined" id="chat-username-input"/>
    </div>
    <div class="col">
        <MudTextField T="string" @bind-Value="password" Immediate="true" Label="Password" Variant="Variant.Outlined" InputType="InputType.Password" id="chat-password-input"/>
    </div>
    <div class="col">
        <MudTextField T="string" Value="@game" ValueChanged="@(async (string v) => { game = v; await SaveSettingsAsync(); })" Immediate="true" Label="Game" Variant="Variant.Outlined" id="chat-game-input"/>
    </div>
    <div class="col-auto">
        @if (IsConnected)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Error" id="chat-connect-button" OnClick="DisconnectAsync">
                Disconnect
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Success" id="chat-connect-button" Disabled="@(!CanConnect)" OnClick="ConnectAsync">
                @(isConnecting ? "Connecting..." : "Connect")
            </MudButton>
        }
    </div>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-3">
        <MudNumericField T="int" Value="@major" ValueChanged="@(async (int v) => { major = v; await SaveSettingsAsync(); })" Label="Major" Variant="Variant.Outlined" Disabled="@(!overrideVersion)" id="chat-version-major-input"/>
    </div>
    <div class="col-md-3">
        <MudNumericField T="int" Value="@minor" ValueChanged="@(async (int v) => { minor = v; await SaveSettingsAsync(); })" Label="Minor" Variant="Variant.Outlined" Disabled="@(!overrideVersion)" id="chat-version-minor-input"/>
    </div>
    <div class="col-md-3">
        <MudNumericField T="int" Value="@build" ValueChanged="@(async (int v) => { build = v; await SaveSettingsAsync(); })" Label="Build" Variant="Variant.Outlined" Disabled="@(!overrideVersion)" id="chat-version-build-input"/>
    </div>
    <div class="col-md-3 d-flex align-items-center">
        <MudCheckBox T="bool" Value="@overrideVersion" ValueChanged="@(async (bool v) => { overrideVersion = v; await SaveSettingsAsync(); })" Label="Override version" id="chat-override-version-checkbox"/>
    </div>
</div>

@if (!string.IsNullOrEmpty(Connector.ConnectionMessage))
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@Connector.ConnectionMessage</MudText>
}

<div class="mb-2">
    <ChatLogView Id="chat-log"/>
</div>

<div class="row g-2">
    <div class="col">
        <MudTextField T="string" @bind-Value="messageText" Immediate="true" Placeholder="Message" Variant="Variant.Outlined" id="chat-message-input" OnKeyDown="OnMessageKeyDown"/>
    </div>
    <div class="col-auto">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" id="chat-send-button" Disabled="@(!CanSend)" OnClick="SendMessage">Send</MudButton>
    </div>
</div>

@code {
    private const string StorageKey = "chat-connection-settings";

    private string url = string.Empty;
    private string username = string.Empty;
    private string password = string.Empty;
    private string game = string.Empty;

    private bool overrideVersion;
    private int major = 0;
    private int minor = 7;
    private int build = 0;

    private bool isConnecting;
    private string messageText = string.Empty;

    [Parameter, SupplyParameterFromQuery(Name = "url")]
    public string? QueryUrl { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "username")]
    public string? QueryUsername { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "game")]
    public string? QueryGame { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "autoConnect")]
    public bool? QueryAutoConnect { get; set; }

    private bool CanConnect => !isConnecting && !string.IsNullOrWhiteSpace(url) && !string.IsNullOrWhiteSpace(username) && !string.IsNullOrWhiteSpace(game);
    private bool CanSend => Connector.LoginResult is LoginSuccessful && !string.IsNullOrWhiteSpace(messageText);
    private bool IsConnected => Connector.LoginResult is LoginSuccessful;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(QueryUrl)) url = QueryUrl;
        if (!string.IsNullOrWhiteSpace(QueryUsername)) username = QueryUsername;
        if (!string.IsNullOrWhiteSpace(QueryGame)) game = QueryGame;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // The stored connection info can only be read once a JS runtime/storage is actually
            // available, so this can't happen in OnInitialized - see BrowserLocalStorageService's
            // own comment. Query-string values (arriving via the Rooms page's Connect button) take
            // priority over whatever was last saved, since they represent an explicit new choice.
            var saved = await LocalStorage.GetItemAsync<ChatConnectionSettings>(StorageKey);
            if (saved is not null)
            {
                if (string.IsNullOrWhiteSpace(url)) url = saved.Url;
                if (string.IsNullOrWhiteSpace(username)) username = saved.Username;
                if (string.IsNullOrWhiteSpace(game)) game = saved.Game;
                overrideVersion = saved.OverrideVersion;
                major = saved.Major;
                minor = saved.Minor;
                build = saved.Build;
                StateHasChanged();
            }

            // Persists whichever values just got resolved above - keeps storage in sync when this
            // load came from query-string params (the Rooms page's Connect button), so returning to
            // this page later remembers that connection too, not just manually-typed ones.
            await SaveSettingsAsync();

            if (QueryAutoConnect == true && CanConnect)
            {
                await ConnectAsync();
            }
        }
    }

    private Task SaveSettingsAsync() => LocalStorage.SetItemAsync(StorageKey, new ChatConnectionSettings
    {
        Url = url,
        Username = username,
        Game = game,
        OverrideVersion = overrideVersion,
        Major = major,
        Minor = minor,
        Build = build
    });

    private async Task ConnectAsync()
    {
        isConnecting = true;
        var version = overrideVersion ? new Version(major, minor, build) : null;
        await Connector.Connect(url, game, username, password, version);
        isConnecting = false;
        StateHasChanged();
    }

    private async Task DisconnectAsync()
    {
        await Connector.Disconnect();
        StateHasChanged();
    }

    private async Task SendMessage()
    {
        if (!CanSend) return;

        await Connector.SendChatMessage(messageText);
        messageText = string.Empty;
    }

    private async Task OnMessageKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SendMessage();
    }
}
