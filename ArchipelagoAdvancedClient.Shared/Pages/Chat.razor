@namespace ArchipelagoAdvancedClient.Shared.Pages
@page "/chat"
@using Archipelago.MultiClient.Net
@using Archipelago.MultiClient.Net.MessageLog.Messages
@using ArchipelagoAdvancedClient.Business
@using ArchipelagoAdvancedClient.Business.APConnector
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IChatService ChatService
@inject IArchipelagoConnectorService Connector
@inject IJSRuntime JS

<PageTitle>Chat</PageTitle>

<div class="row g-2 align-items-end mb-2">
    <div class="col">
        <MudTextField T="string" @bind-Value="url" Immediate="true" Label="URL" Variant="Variant.Outlined" id="chat-url-input"/>
    </div>
    <div class="col">
        <MudTextField T="string" @bind-Value="username" Immediate="true" Label="Username" Variant="Variant.Outlined" id="chat-username-input"/>
    </div>
    <div class="col">
        <MudTextField T="string" @bind-Value="password" Immediate="true" Label="Password" Variant="Variant.Outlined" InputType="InputType.Password" id="chat-password-input"/>
    </div>
    <div class="col">
        <MudTextField T="string" @bind-Value="game" Immediate="true" Label="Game" Variant="Variant.Outlined" id="chat-game-input"/>
    </div>
    <div class="col-auto">
        @if (IsConnected)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Error" id="chat-connect-button" OnClick="DisconnectAsync">
                Disconnect
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Success" id="chat-connect-button" Disabled="@(!CanConnect)" OnClick="ConnectAsync">
                @(isConnecting ? "Connecting..." : "Connect")
            </MudButton>
        }
    </div>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-3">
        <MudNumericField T="int" @bind-Value="major" Label="Major" Variant="Variant.Outlined" Disabled="@(!overrideVersion)" id="chat-version-major-input"/>
    </div>
    <div class="col-md-3">
        <MudNumericField T="int" @bind-Value="minor" Label="Minor" Variant="Variant.Outlined" Disabled="@(!overrideVersion)" id="chat-version-minor-input"/>
    </div>
    <div class="col-md-3">
        <MudNumericField T="int" @bind-Value="build" Label="Build" Variant="Variant.Outlined" Disabled="@(!overrideVersion)" id="chat-version-build-input"/>
    </div>
    <div class="col-md-3 d-flex align-items-center">
        <MudCheckBox T="bool" @bind-Value="overrideVersion" Label="Override version" id="chat-override-version-checkbox"/>
    </div>
</div>

@if (!string.IsNullOrEmpty(Connector.ConnectionMessage))
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@Connector.ConnectionMessage</MudText>
}

<div class="chat-log mb-2" id="chat-log" @ref="chatLogElement">
    @foreach (var message in ChatService.Log)
    {
        <div class="chat-line">
            @foreach (var part in message.Parts)
            {
                <span style="color: rgb(@part.Color.R, @part.Color.G, @part.Color.B)">@part.Text</span>
            }
        </div>
    }
</div>

<div class="row g-2">
    <div class="col">
        <MudTextField T="string" @bind-Value="messageText" Immediate="true" Placeholder="Message" Variant="Variant.Outlined" id="chat-message-input" OnKeyDown="OnMessageKeyDown"/>
    </div>
    <div class="col-auto">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" id="chat-send-button" Disabled="@(!CanSend)" OnClick="SendMessage">Send</MudButton>
    </div>
</div>

@code {
    private string url = string.Empty;
    private string username = string.Empty;
    private string password = string.Empty;
    private string game = string.Empty;

    private bool overrideVersion;
    private int major = 0;
    private int minor = 7;
    private int build = 0;

    private bool isConnecting;
    private string messageText = string.Empty;

    private ElementReference chatLogElement;
    private IJSObjectReference? scrollModule;
    private bool pendingScrollToBottom;

    [Parameter, SupplyParameterFromQuery(Name = "url")]
    public string? QueryUrl { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "username")]
    public string? QueryUsername { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "game")]
    public string? QueryGame { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "autoConnect")]
    public bool? QueryAutoConnect { get; set; }

    private bool CanConnect => !isConnecting && !string.IsNullOrWhiteSpace(url) && !string.IsNullOrWhiteSpace(username) && !string.IsNullOrWhiteSpace(game);
    private bool CanSend => Connector.LoginResult is LoginSuccessful && !string.IsNullOrWhiteSpace(messageText);
    private bool IsConnected => Connector.LoginResult is LoginSuccessful;

    protected override void OnInitialized()
    {
        ChatService.LogChanged += OnLogChanged;

        if (!string.IsNullOrWhiteSpace(QueryUrl)) url = QueryUrl;
        if (!string.IsNullOrWhiteSpace(QueryUsername)) username = QueryUsername;
        if (!string.IsNullOrWhiteSpace(QueryGame)) game = QueryGame;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && QueryAutoConnect == true && CanConnect)
        {
            await ConnectAsync();
        }

        if (pendingScrollToBottom)
        {
            pendingScrollToBottom = false;
            var module = await GetScrollModuleAsync();
            await module.InvokeVoidAsync("scrollToBottom", chatLogElement);
        }
    }

    private async Task<IJSObjectReference> GetScrollModuleAsync() =>
        scrollModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/ArchipelagoAdvancedClient.Shared/js/chat-scroll.js");

    private async Task ConnectAsync()
    {
        isConnecting = true;
        var version = overrideVersion ? new Version(major, minor, build) : null;
        await Connector.Connect(url, game, username, password, version);
        isConnecting = false;
        StateHasChanged();
    }

    private async Task DisconnectAsync()
    {
        await Connector.Disconnect();
        StateHasChanged();
    }

    private async Task SendMessage()
    {
        if (!CanSend) return;

        await Connector.SendChatMessage(messageText);
        messageText = string.Empty;
    }

    private async Task OnMessageKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SendMessage();
    }

    private async void OnLogChanged()
    {
        // Checked here, before StateHasChanged triggers a re-render with the new message, so this
        // reflects whether the user was scrolled to the bottom of the *previous* content - the
        // correct signal for "were they following along" rather than "will they end up at the
        // bottom after the new message is added".
        try
        {
            var module = await GetScrollModuleAsync();
            pendingScrollToBottom = await module.InvokeAsync<bool>("isAtBottom", chatLogElement);
        }
        catch (JSException)
        {
            pendingScrollToBottom = true;
        }

        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        ChatService.LogChanged -= OnLogChanged;

        if (scrollModule is not null)
        {
            try
            {
                await scrollModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // circuit/runtime already tearing down - nothing to clean up
            }
        }
    }
}
