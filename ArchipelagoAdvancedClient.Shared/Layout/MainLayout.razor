@namespace ArchipelagoAdvancedClient.Shared.Layout
@inherits LayoutComponentBase
@using ArchipelagoAdvancedClient.Shared.Services
@inject IExternalLinkOpener LinkOpener

<div class="page">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://github.com/TrueNiv/ArchipelagoAdvancedClient" target="_blank" @onclick="OpenGitHub" @onclick:preventDefault="true">GitHub</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private Task OpenGitHub() => LinkOpener.OpenAsync("https://github.com/TrueNiv/ArchipelagoAdvancedClient");
}